```{=html}
<ul class="pub-list list list-unstyled">
<% for (const item of items) { %>
  <li <%= metadataAttrs(item) %>>
    <span class="listing-author"><%= item.author %></span>
    <span class="listing-year">(<%= item.year %>)</span>
    <span class="listing-title fw-bold"><%= item.title %>.</span>
    <span class="listing-publication fst-italic"><%= item.publication %>.</span>
    <% if (item.editors) { %><span class="listing-author"><%= item.editors %> eds.</span><% } %>
    <% if (item.volume) { %><span class="listing-volume"><%= item.volume %>:</span><% } %>
    <% if (item.pages) { %><span class="listing-pages"><%= item.pages %>.</span><% } %>
    <br>

    <div class="d-grid d-md-flex d-small justify-content-md-end gap-1">

      <% if (item.url_preprint) { %>
      <a href="<%- item.url_preprint %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
        <i class="bi bi-card-text" style="font-size: 1rem"></i> preprint
      </a>
      <% } %>

      <% if (item.path) { %>
      <a href="<%- item.path %>" class="btn btn-secondary btn-sm">
        <i class="bi bi-list-task" style="font-size: 1rem"></i> Abstract &amp; More »
      </a>
      <% } %>

      <% if (item.pdf) { %>
      <a href="<%- item.pdf %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
        <i class="bi bi-file-earmark-pdf" style="font-size: 1rem"></i> pdf
      </a>
      <% } %>

      <% if (item.url_code) { %>
      <a href="<%- item.url_code %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
        <i class="bi bi-github" style="font-size: 1rem"></i> code
      </a>
      <% } %>

      <% if (item.url_dataset) { %>
      <a href="<%- item.url_dataset %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
        <i class="bi bi-clipboard-data" style="font-size: 1rem"></i> data
      </a>
      <% } %>

      <% if (item.bib) { %>
      <a href="<%- item.bib %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
        <i class="bi bi-blockquote-left" style="font-size: 1rem"></i> bib
      </a>
      <% } %>

      <% if (item.url) { %>
      <a href="<%- item.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
        <i class="bi bi-link" style="font-size: 1rem"></i> url
      </a>
      <% } %>

    </div>
    <hr width="100%" size="2" color="blue" noshade>
  </li>
<% } %>
</ul>
```